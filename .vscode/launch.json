        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/c",
        "args": ["${workspaceFolder}/data/matrices_no_mappings/AGT006+1/test0010M1.csv", 
                 "${workspaceFolder}/data/matrices_no_mappings/AGT006+1/test0010M2.csv",
                 "${workspaceFolder}/data/matrices_no_mappings/AGT006+1/test0010M3.csv",
                 "verbose"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],

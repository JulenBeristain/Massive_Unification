{
	"version": "2.0.0",
	"tasks": [

		{
			"label": "MAC build core for debugging (clang)",
			"type": "cppbuild",
			"command": "/usr/bin/clang",
			"args": [
				"-o",
				"${workspaceFolder}/c",
				"${workspaceFolder}/core.c",
				"-Wall",
				"-Wextra",
				"-g",
				"-O0",
				"${workspaceFolder}/structures.c",	// TODO: when no longer needed to compile core, remove it!
				"${workspaceFolder}/Schemas/set_variables.c",
				"${workspaceFolder}/Schemas/arena.c",
				"${workspaceFolder}/Schemas/schemas.c",
				"${workspaceFolder}/Schemas/utils.c",
				"${workspaceFolder}/Schemas/cache_mapping.c", // TODO: when no longer needed to compile core, remove it!
				"${workspaceFolder}/postprocessing_to_mnf.c",
				"-lm"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},

		{
			"label": "MAC build core O2 (clang)",
			"type": "cppbuild",
			"command": "/usr/bin/clang",
			"args": [
				"-o",
				"${workspaceFolder}/c",
				"${workspaceFolder}/core.c",
				"-Wall",
				"-Wextra",
				"-O2",
				"${workspaceFolder}/structures.c",	// TODO: when no longer needed to compile core, remove it!
				"${workspaceFolder}/Schemas/set_variables.c",
				"${workspaceFolder}/Schemas/arena.c",
				"${workspaceFolder}/Schemas/schemas.c",
				"${workspaceFolder}/Schemas/utils.c",
				"${workspaceFolder}/Schemas/cache_mapping.c", // TODO: when no longer needed to compile core, remove it!
				"${workspaceFolder}/postprocessing_to_mnf.c",
				"-lm"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},

		// TODO: adapt these to the latest version of the repository!
		{
			"label": "build core for debugging (gcc)",
			"type": "shell",
			"command": "gcc",
			"args": [
				"-o",
				"c",
				"core_optimized.c",
				"-Wall",
				"-Wextra",
				"-g",
				"-O0",
				"structures.c",
				"Schemas/set_variables.c",
				"Schemas/arena.c",
				"Schemas/schemas.c",
				"Schemas/utils.c",
				"Schemas/cache_mapping.c",
				"-lm"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		},

		{
            "label": "valgrind core",
            "type": "shell",
            "command": "valgrind",
            "args": [
                "--leak-check=full",
                "--show-leak-kinds=all",
                "--track-origins=yes",
                "--verbose",
                "--log-file=${workspaceFolder}/build/valgrind-core-out.txt",
                "${workspaceFolder}/c",
                "${workspaceFolder}/data/experimentation_matrices/SEV/SEV437+1.p/test0003M1.csv", 
                "${workspaceFolder}/data/experimentation_matrices/SEV/SEV437+1.p/test0003M2.csv",
                "${workspaceFolder}/data/experimentation_matrices/SEV/SEV437+1.p/test0003M3.csv",
				"verbose"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "dependsOn": "build core no perfect hash for debugging (gcc)" 
        },
	]
}